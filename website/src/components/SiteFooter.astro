---
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/Caracolaracol/tuxedo-task';
---
<footer class="site-footer">
  <div>
    <a class="brand" href={base}><img src={`${base}brand.svg`} width="32" height="32" alt="" /><span>Tuxedo<span class="brand-task">Task</span><span class="brand-dot">.</span></span></a>
    <p>Plain text. Thoughtfully extended.</p>
  </div>
  <div class="footer-credit">
    <p>An independent community fork of <a href="https://github.com/webstonehq/tuxedo">Tuxedo by Webstone Technologies</a>.<br />Maintained by <a href="https://github.com/Caracolaracol">Caracolaracol</a>. Original credits and MIT license preserved.</p>
    <div><a href={`${base}docs/`}>Documentation</a><a href={`${repo}/blob/main/LICENSE`}>MIT license</a><a href={`${repo}/issues`}>Say hello / report a bug <span aria-hidden="true">↗</span></a><a href={repo}>Source code <span aria-hidden="true">↗</span></a></div>
    <p class="art-credit">Rose border: <a href="https://openclipart.org/detail/1352/rose-border">johnny_automatic / Openclipart</a>, <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>. Other roses: <a href="https://github.com/jdecked/twemoji/blob/b6b55fef1e8636b540a6d016a4729ca8cdf2e60b/assets/svg/1f339.svg">Twemoji contributors</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p>
  </div>
</footer>
